        (200 . "[]")
        (200 . "{\"tasks\":[{\"id\":\"one\",\"title\":\"Server edit\",\"projectId\":\"inbox\"}]}")
        (200 . "{\"id\":\"one\",\"title\":\"Server edit\",\"projectId\":\"inbox\"}")
        (200 . "{\"id\":\"one\",\"title\":\"Server edit\",\"projectId\":\"inbox\"}"))
