;;; ticktick-test.el --- Regression tests for sync failures -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'ticktick)

(defvar ticktick-test--responses nil)
(defvar ticktick-test--requests nil)

(defun ticktick-test--request (url &rest settings)
  "Serve the next canned response to URL using request SETTINGS."
  (push (list url settings) ticktick-test--requests)
  (unless ticktick-test--responses (error "Unexpected request: %s" url))
  (let* ((entry (pop ticktick-test--responses))
         (status (car entry))
         (response (make-request-response :status-code status)))
    (if (and (numberp status) (<= 200 status) (< status 300))
        (condition-case err
            (let ((data (with-temp-buffer
                          (insert (cdr entry))
                          (funcall (plist-get settings :parser)))))
              (funcall (plist-get settings :success) :data data :response response))
          (error (funcall (plist-get settings :error)
                          :response response :error-thrown err)))
      (funcall (plist-get settings :error)
               :response response :error-thrown '(error "Request failed")))))

(defmacro ticktick-test--with-api (responses &rest body)
  "Run BODY with canned RESPONSES and isolated sync storage."
  (declare (indent 1))
  `(let* ((ticktick-test--responses ,responses)
          (ticktick-test--requests nil)
          (ticktick-dir (make-temp-file "ticktick-test-" t))
          (ticktick-sync-file (expand-file-name "tasks.org" ticktick-dir))
          (ticktick-archive-file (expand-file-name "archive.org" ticktick-dir))
          (ticktick-token '(:access_token "test"))
          (ticktick--sync-state (copy-tree '(:api-task-ids ("existing") :last-sync-time "before"))))
     (unwind-protect
         (cl-letf (((symbol-function 'ticktick-ensure-token) #'ignore)
                   ((symbol-function 'request) #'ticktick-test--request))
           ,@body)
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer)
                    (file-in-directory-p (buffer-file-name buffer) ticktick-dir))
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (delete-directory ticktick-dir t))))

(ert-deftest ticktick-request-signals-http-and-transport-failures ()
  (dolist (status '(500 403 nil))
    (ticktick-test--with-api (list (cons status ""))
      (should-error (ticktick-request "GET" "/open/v1/project")))))

(ert-deftest ticktick-request-rejects-invalid-and-empty-get-responses ()
  (dolist (body '("" "not JSON"))
    (ticktick-test--with-api (list (cons 200 body))
      (should-error (ticktick-request "GET" "/open/v1/project")))))

(ert-deftest ticktick-request-retries-once-with-original-body ()
  (ticktick-test--with-api '((401 . "") (200 . "{\"id\":\"task\"}"))
    (let ((refreshes 0))
      (cl-letf (((symbol-function 'ticktick-refresh-token)
                 (lambda () (cl-incf refreshes))))
        (should (equal (ticktick-request "POST" "/task" '(("title" . "hello")))
                       '(:id "task")))
        (should (= refreshes 1))
        (should (= (length ticktick-test--requests) 2))
        (dolist (entry ticktick-test--requests)
          (should (equal (plist-get (cadr entry) :data) "{\"title\":\"hello\"}")))))))

(ert-deftest ticktick-request-stops-after-repeated-unauthorized ()
  (ticktick-test--with-api '((401 . "") (401 . ""))
    (cl-letf (((symbol-function 'ticktick-refresh-token) #'ignore))
      (should-error (ticktick-request "GET" "/project"))
      (should (= (length ticktick-test--requests) 2)))))

(ert-deftest ticktick-delete-failure-is-recorded-and-preserves-org-task ()
  (ticktick-test--with-api
      '((200 . "{\"id\":\"existing\",\"projectId\":\"inbox\",\"title\":\"Keep me\"}")
        (200 . "{\"id\":\"existing\",\"projectId\":\"inbox\",\"title\":\"Keep me\"}")
        (500 . ""))
    (with-current-buffer (find-file-noselect ticktick-sync-file)
      (org-mode)
      (insert "* Work\n:PROPERTIES:\n:TICKTICK_PROJECT_ID: inbox\n:END:\n** TODO Keep me\n:PROPERTIES:\n:TICKTICK_ID: existing\n:END:\n")
      (save-buffer)
      (goto-char (point-min))
      (search-forward "** TODO")
      (beginning-of-line)
      (let ((before (buffer-string))
            (ticktick-delete-behavior 'delete))
        (should-error (ticktick-delete-task-at-point))
        (should (equal before (buffer-string)))
        (should (= 1 (length (plist-get ticktick--sync-state :failed-operations))))))))

(ert-deftest ticktick-delete-empty-success-is-not-a-failure ()
  (ticktick-test--with-api '((204 . ""))
    (should (ticktick--delete-task-from-api "existing" "inbox"))
    (should-not (plist-get ticktick--sync-state :failed-operations))))

(ert-deftest ticktick-fetch-failures-preserve-state-and-skip-deletions ()
  (dolist (responses '(((500 . ""))
                       ((200 . "[]") (500 . ""))
                       ((200 . "[{\"id\":\"work\",\"name\":\"Work\"}]")
                        (200 . "{\"tasks\":[]}") (500 . ""))
                       ((200 . "[]") (200 . "{}"))
                       ((200 . "[]") (200 . "{\"tasks\":[{}]}"))))
    (ticktick-test--with-api responses
      (ticktick--ensure-state-initialized)
      (let ((before (copy-tree ticktick--sync-state))
            (handled nil))
        (cl-letf (((symbol-function 'ticktick--handle-api-deletions)
                   (lambda (_) (setq handled t))))
          (should-error (ticktick-fetch-to-org))
          (should-not handled)
          (should (equal before ticktick--sync-state))
          (should-not (file-exists-p ticktick-sync-file)))))))

(ert-deftest ticktick-fetch-empty-project-is-valid-without-refetch ()
  (ticktick-test--with-api '((200 . "[]") (200 . "{\"tasks\":[]}"))
    (setq ticktick--sync-state (ticktick--migrate-state nil))
    (ticktick-fetch-to-org)
    (should-not (plist-get ticktick--sync-state :api-task-ids))
    (should (= 2 (length ticktick-test--requests)))))

(ert-deftest ticktick-snapshot-normalizes-tags-and-timed-deadlines ()
  (let* ((task '(:title "Test" :content " body " :tags ("z" "a" "z")
                 :dueDate "2026-11-06T15:30:00+0200" :isAllDay :false
                 :timeZone "Europe/Helsinki" :projectId "work"))
         (snapshot (ticktick--snapshot-from-api task)))
    (should (equal (plist-get snapshot :tags) '("a" "z")))
    (should (equal (plist-get snapshot :content) "body"))
    (should (equal (plist-get (plist-get snapshot :deadline) :value)
                   "2026-11-06T13:30:00Z"))
    (should (equal (cdr (assoc "timeZone" (ticktick--snapshot-to-payload snapshot)))
                   "Europe/Helsinki"))))

(ert-deftest ticktick-snapshot-org-ignores-sync-properties ()
  (with-temp-buffer
    (org-mode)
    (insert "* Work\n:PROPERTIES:\n:TICKTICK_PROJECT_ID: work\n:END:\n"
            "** TODO [#A] Test :z:a:\nDEADLINE: <2026-11-06 Fri>\nbody\n")
    (goto-char (point-min)) (search-forward "** TODO") (beginning-of-line)
    (let ((snapshot (ticktick--snapshot-from-org)))
      (org-set-property "LAST_SYNCED" "now")
      (org-set-property "TICKTICK_ID" "123")
      (should (equal snapshot (ticktick--snapshot-from-org)))
      (should (equal (plist-get snapshot :tags) '("a" "z")))
      (should (equal (plist-get (plist-get snapshot :deadline) :value) "2026-11-06")))))

(ert-deftest ticktick-state-migration-preserves-history-without-assuming-a-base ()
  (let* ((old '(:org-task-ids ("one") :api-task-ids ("two")))
         (new (ticktick--migrate-state (copy-tree old))))
    (should (equal (plist-get new :org-task-ids) '("one")))
    (should (equal (plist-get new :api-task-ids) '("two")))
    (should-not (plist-get new :baselines))
    (should (equal new (ticktick--migrate-state (copy-tree new))))
    (should-error (ticktick--migrate-state '(:version 999)))))

(ert-deftest ticktick-baselines-survive-state-roundtrip ()
  (ticktick-test--with-api nil
    (ticktick--ensure-state-initialized)
    (ticktick--set-baseline "one" '(:title "before"))
    (ticktick--save-state)
    (setq ticktick--sync-state nil)
    (ticktick--load-state)
    (should (equal (ticktick--baseline "one") '(:title "before")))
    (should (= (logand (file-modes (ticktick--state-file-path)) #o777) #o600))
    (ticktick--set-baseline "one" nil)
    (should-not (ticktick--baseline "one"))))

(defun ticktick-test--record (snapshot)
  "Wrap SNAPSHOT in an identified record."
  (and snapshot (list :id "one" :key "one" :snapshot snapshot)))

(ert-deftest ticktick-plan-holds-concurrent-and-unbased-edits ()
  (let ((ticktick--sync-state nil)
        (base '(:title "base")))
    (dolist (case '(("base" "remote" pull) ("local" "base" push)
                    ("same" "same" agree) ("local" "remote" conflict)))
      (let ((plan (ticktick--plan-task
                   (ticktick-test--record (list :title (nth 0 case)))
                   (ticktick-test--record (list :title (nth 1 case))) base)))
        (should (eq (plist-get plan :action) (nth 2 case)))))
    (should (eq (plist-get (ticktick--plan-task
                            (ticktick-test--record '(:title "local"))
                            (ticktick-test--record '(:title "remote")) nil) :action)
                'conflict))))

(ert-deftest ticktick-remote-verifies-missing-completed-task ()
  (ticktick-test--with-api
      '((200 . "[]") (200 . "{\"tasks\":[]}")
        (200 . "{\"id\":\"one\",\"projectId\":\"inbox\",\"title\":\"Done\",\"status\":2}"))
    (setq ticktick--sync-state (list :baselines '(("one" . (:project-id "inbox")))))
    (let ((records (ticktick--collect-remote-records nil)))
      (should (= (length records) 1))
      (should (= (plist-get (plist-get (car records) :snapshot) :status) 2)))))

(ert-deftest ticktick-remote-only-404-confirms-absence ()
  (ticktick-test--with-api '((404 . ""))
    (should-not (ticktick--read-remote-task "one" "inbox")))
  (ticktick-test--with-api '((403 . ""))
    (should-error (ticktick--read-remote-task "one" "inbox"))))

(ert-deftest ticktick-sync-import-establishes-baseline-after-saving ()
  (ticktick-test--with-api
      '((200 . "[]")
        (200 . "{\"tasks\":[{\"id\":\"one\",\"title\":\"Imported\",\"projectId\":\"inbox\"}]}")
        (200 . "{\"id\":\"one\",\"title\":\"Imported\",\"projectId\":\"inbox\"}"))
    (setq ticktick--sync-state (ticktick--migrate-state nil))
    (ticktick-sync)
    (should (equal (plist-get (ticktick--baseline "one") :title) "Imported"))
    (should (equal (ticktick--baseline "one")
                   (plist-get (ticktick--local-record "one") :snapshot)))
    (should-not (plist-get ticktick--sync-state :pending-operations))
    (should-not (plist-get ticktick--sync-state :conflicts))))

(ert-deftest ticktick-uncertain-creation-is-never-automatically-retried ()
  (ticktick-test--with-api
      '((200 . "[]") (200 . "{\"tasks\":[]}") (201 . "")
        (200 . "[]") (200 . "{\"tasks\":[]}"))
    (setq ticktick--sync-state (ticktick--migrate-state nil))
    (with-current-buffer (find-file-noselect ticktick-sync-file)
      (org-mode)
      (insert "* Inbox\n:PROPERTIES:\n:TICKTICK_PROJECT_ID: inbox\n:END:\n** TODO New\n")
      (save-buffer))
    (ticktick-sync)
    (should (= 1 (length (plist-get ticktick--sync-state :pending-operations))))
    (ticktick-sync)
    (should (= 5 (length ticktick-test--requests)))
    (should (= 1 (length (plist-get ticktick--sync-state :pending-operations))))))

(ert-deftest ticktick-executor-rechecks-remote-before-local-import ()
  (ticktick-test--with-api
      '((200 . "{\"id\":\"one\",\"projectId\":\"inbox\",\"title\":\"Changed again\"}"))
    (let* ((remote (list :id "one" :key "one" :snapshot
                         (ticktick--snapshot-from-api
                          '(:id "one" :projectId "inbox" :title "Original"))))
           (operation (ticktick--plan-task nil remote nil)))
      (should-error (ticktick--execute-operation operation))
      (should-not (ticktick--baseline "one"))
      (should-not (file-exists-p ticktick-sync-file)))))

(ert-deftest ticktick-interrupted-local-save-recovers-without-remote-write ()
  (ticktick-test--with-api
      '((200 . "[]")
        (200 . "{\"tasks\":[{\"id\":\"one\",\"title\":\"Imported\",\"projectId\":\"inbox\"}]}")
        (200 . "{\"id\":\"one\",\"title\":\"Imported\",\"projectId\":\"inbox\"}")
        (200 . "[]")
        (200 . "{\"tasks\":[{\"id\":\"one\",\"title\":\"Imported\",\"projectId\":\"inbox\"}]}"))
    (setq ticktick--sync-state (ticktick--migrate-state nil))
    (cl-letf (((symbol-function 'ticktick--write-local-snapshot)
               (lambda (&rest _) (error "Disk unavailable"))))
      (ticktick-sync))
    (should-not (ticktick--baseline "one"))
    (should (= 1 (length (plist-get ticktick--sync-state :pending-operations))))
    ;; Simulate restarting Emacs with only the durable state.
    (setq ticktick--sync-state nil)
    (ticktick--load-state)
    (ticktick-sync)
    (should (equal (plist-get (ticktick--baseline "one") :title) "Imported"))
    (should-not (plist-get ticktick--sync-state :pending-operations))
    (dolist (entry ticktick-test--requests)
      (should (equal (plist-get (cadr entry) :type) "GET")))))

(defun ticktick-test--seed-task (title)
  "Save a task with TITLE and an unrelated property for integration tests."
  (with-current-buffer (find-file-noselect ticktick-sync-file)
    (org-mode)
    (erase-buffer)
    (insert "* Inbox\n:PROPERTIES:\n:TICKTICK_PROJECT_ID: inbox\n:END:\n"
            "** TODO " title "\n:PROPERTIES:\n:TICKTICK_ID: one\n:CUSTOM: keep\n:END:\n")
    (save-buffer))
  (ticktick--local-record "one"))

(ert-deftest ticktick-review-resolution-preserves-unrelated-org-properties ()
  (ticktick-test--with-api
      '((200 . "{\"id\":\"one\",\"title\":\"Remote\",\"projectId\":\"inbox\"}")
        (200 . "{\"id\":\"one\",\"title\":\"Remote\",\"projectId\":\"inbox\"}"))
    (let* ((local (ticktick-test--seed-task "Local"))
           (remote (ticktick-test--record
                    (ticktick--snapshot-from-api '(:title "Remote" :projectId "inbox"))))
           (conflict (ticktick--plan-task local remote '(:title "Base"))))
      (setq ticktick--sync-state (plist-put ticktick--sync-state :conflicts (list conflict)))
      (ticktick-resolve-conflict "one" 'ticktick)
      (should (equal (plist-get (ticktick--baseline "one") :title) "Remote"))
      (should-not (plist-get ticktick--sync-state :conflicts))
      (with-current-buffer (find-file-noselect ticktick-sync-file)
        (goto-char (plist-get (ticktick--local-record "one") :position))
        (should (equal (org-entry-get nil "CUSTOM") "keep"))))))

(ert-deftest ticktick-resolution-refuses-stale-local-version ()
  (ticktick-test--with-api nil
    (let* ((local (ticktick-test--seed-task "Local"))
           (conflict (ticktick--plan-task local (ticktick-test--record '(:title "Remote")) nil)))
      (setq ticktick--sync-state (plist-put ticktick--sync-state :conflicts (list conflict)))
      (with-current-buffer (find-file-noselect ticktick-sync-file)
        (goto-char (plist-get local :position))
        (org-edit-headline "New local edit"))
      (should-error (ticktick-resolve-conflict "one" 'ticktick))
      (should-not ticktick-test--requests))))

(ert-deftest ticktick-merge-editor-roundtrips-timed-task ()
  (ticktick-test--with-api nil
    (let* ((snapshot (ticktick--snapshot-from-api
                      '(:title "Task" :projectId "inbox" :priority 5 :status 2
                        :content "Description" :dueDate "2026-11-06T13:30:00Z"
                        :timeZone "Europe/Helsinki" :isAllDay :false :tags ("work"))))
           (conflict (list :key "one" :id "one" :local snapshot)))
      (setq ticktick--sync-state (plist-put ticktick--sync-state :conflicts (list conflict)))
      (save-window-excursion
        (unwind-protect
            (progn
              (ticktick-edit-conflict "one")
              (should (equal snapshot (ticktick--snapshot-from-org)))
              (should (eq (key-binding (kbd "C-c C-c")) #'ticktick-conflict-edit-save)))
          (when (get-buffer "*TickTick Merge*") (kill-buffer "*TickTick Merge*")))))))

(ert-deftest ticktick-deletion-plan-distinguishes-unchanged-from-edited-survivor ()
  (let* ((ticktick--sync-state nil)
         (base '(:title "Base"))
         (unchanged (ticktick-test--record base))
         (edited (ticktick-test--record '(:title "Edited"))))
    (should (eq (plist-get (ticktick--plan-task nil unchanged base) :action) 'delete-remote))
    (should (eq (plist-get (ticktick--plan-task unchanged nil base) :action) 'delete-local))
    (should (eq (plist-get (ticktick--plan-task nil edited base) :action) 'conflict))
    (should (eq (plist-get (ticktick--plan-task edited nil base) :action) 'conflict))))

(ert-deftest ticktick-confirmed-remote-deletion-archives-before-clearing-baseline ()
  (dolist (location '(separate-file archive-heading))
    (ticktick-test--with-api '((200 . "[]") (200 . "{\"tasks\":[]}")
                              (404 . "") (404 . ""))
      (setq ticktick--sync-state (ticktick--migrate-state nil))
      (let* ((record (ticktick-test--seed-task "Archive me"))
             (ticktick-delete-behavior 'archive)
             (ticktick-confirm-deletions nil)
             (ticktick-archive-location location))
        (ticktick--set-baseline "one" (plist-get record :snapshot))
        (ticktick-sync)
        (should-not (ticktick--baseline "one"))
        (should-not (ticktick--local-record "one"))
        (should-not (plist-get ticktick--sync-state :conflicts))
        (with-temp-buffer
          (insert-file-contents (if (eq location 'separate-file)
                                    ticktick-archive-file ticktick-sync-file))
          (should (search-forward "Archive me" nil t))
          (should (search-forward ":ARCHIVED_AT:" nil t)))))))

(ert-deftest ticktick-ask-deletion-policy-records-review-without-prompting ()
  (ticktick-test--with-api '((200 . "[]") (200 . "{\"tasks\":[]}") (404 . ""))
    (setq ticktick--sync-state (ticktick--migrate-state nil))
    (let* ((record (ticktick-test--seed-task "Keep until reviewed"))
           (ticktick-delete-behavior 'ask))
      (ticktick--set-baseline "one" (plist-get record :snapshot))
      (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) (error "Unexpected prompt"))))
        (ticktick-sync))
      (should (ticktick--local-record "one"))
      (should (ticktick--baseline "one"))
      (should (eq (plist-get (car (plist-get ticktick--sync-state :conflicts)) :action)
                  'delete-local)))))

(ert-deftest ticktick-keep-local-after-remote-deletion-recreates-and-replaces-id ()
  (ticktick-test--with-api
      '((404 . "")
        (200 . "{\"id\":\"two\",\"title\":\"Edited locally\",\"projectId\":\"inbox\"}")
        (200 . "{\"id\":\"two\",\"title\":\"Edited locally\",\"projectId\":\"inbox\"}"))
    (setq ticktick--sync-state (ticktick--migrate-state nil))
    (let* ((local (ticktick-test--seed-task "Edited locally"))
           (base (plist-put (copy-tree (plist-get local :snapshot)) :title "Before"))
           (conflict (ticktick--plan-task local nil base)))
      (ticktick--set-baseline "one" base)
      (setq ticktick--sync-state (plist-put ticktick--sync-state :conflicts (list conflict)))
      (ticktick-resolve-conflict "one" 'org)
      (should-not (ticktick--baseline "one"))
      (should-not (ticktick--local-record "one"))
      (should (ticktick--local-record "two"))
      (should (equal (plist-get (ticktick--baseline "two") :title) "Edited locally"))
      (should-not (plist-get ticktick--sync-state :pending-operations)))))

